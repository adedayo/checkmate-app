# Dependencies
node_modules

# Build outputs
build/bin
frontend/dist
debug_wails.js
package.json.md5

# The compiled binary. Anchored to the repository root on purpose: unanchored,
# `checkmate-app` also matches any directory of that name anywhere in the tree
# and would silently exclude its contents.
/checkmate-app

# Windows and Go build products. `*.test` catches binaries left by
# `go test -c`; `*.exe` catches locally cross-compiled Windows builds.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Signing material. None of this belongs in a repository under any
# circumstances — it lives in CI secrets. Listed explicitly so an accidental
# `git add -A` after a local signing experiment cannot stage it.
*.p12
*.pfx
*.key
*.keychain
*.mobileprovision
*.cer

# Local databases, including SQLite WAL and shared-memory sidecars. A stray dev
# database is a real scan history, not a scratch file.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment and secrets
.env
.env.local
.env.*.local

# Coverage and profiling output
coverage.out
*.cover
*.prof
*.pprof

# Scratch. `tmp_*` is the convention across these repositories for throwaway
# main packages written while debugging.
tmp_*/
*.log
*.tmp
*.bak
*.orig

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Regenerated by the Wails CLI from wails.json on every build. Committing it
# freezes the values it exists to interpolate.
build/windows/installer/wails_tools.nsh

# Local-only multi-repository development. The committed go.mod pins a released
# checkmate; go.work is how you build against ../checkmate without making that
# override part of the module and therefore part of every release build.
go.work
go.work.sum

# Release artefacts, produced by the workflow and never committed.
*.dmg
*.AppImage
*.deb
*.rpm
*.pkg
*.msi
SHA256SUMS
*.sig
*.pem
*.spdx.json
dist-release/
